<mujoco model="TASS compound-eye two-wheel cart">
  <compiler angle="degree"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="192" offheight="96"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5"/>
  </visual>
  <asset>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.12 0.15 0.18"
             rgb2="0.32 0.36 0.40" width="256" height="256"/>
    <material name="floor" texture="checker" texrepeat="10 10"/>
  </asset>
  <default>
    <geom friction="1.5 0.01 0.001"/>
    <joint damping="0.05"/>
  </default>
  <worldbody>
    <light pos="0 0 5" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="floor"/>
    <geom name="wall_n" type="box" pos="0 4 0.4" size="4.1 0.1 0.4" rgba="0.65 0.68 0.72 1"/>
    <geom name="wall_s" type="box" pos="0 -4 0.4" size="4.1 0.1 0.4" rgba="0.65 0.68 0.72 1"/>
    <geom name="wall_e" type="box" pos="4 0 0.4" size="0.1 4 0.4" rgba="0.65 0.68 0.72 1"/>
    <geom name="wall_w" type="box" pos="-4 0 0.4" size="0.1 4 0.4" rgba="0.65 0.68 0.72 1"/>
    <geom name="column_left" type="cylinder" pos="1.4 1.2 0.45" size="0.18 0.45" rgba="0.15 0.85 0.30 1"/>
    <geom name="column_right" type="cylinder" pos="2.2 -1.1 0.45" size="0.24 0.45" rgba="0.20 0.35 0.95 1"/>
    <geom name="block_front" type="box" pos="3.0 0.2 0.35" size="0.2 0.45 0.35" rgba="0.9 0.18 0.12 1"/>
    <body name="visual_target" mocap="true" pos="1.8 0 0.25">
      <geom name="moving_target" type="sphere" size="0.16" rgba="1 0.95 0.1 1"/>
    </body>
    <!-- Physical planar two-wheel cart. Eye renders are sampled internally;
         users see the photoreceptor mosaic instead of raw camera RGB. -->
    <body name="cart" pos="0 0 0.155">
      <joint name="cart_x" type="slide" axis="1 0 0" damping="0"/>
      <joint name="cart_y" type="slide" axis="0 1 0" damping="0"/>
      <joint name="cart_heading" type="hinge" axis="0 0 1" damping="0"/>
      <geom name="chassis" type="box" size="0.14 0.11 0.06" mass="0.5" rgba="0.08 0.42 0.72 1"/>
      <geom name="eye_marker_left" type="sphere" pos="0.14 0.055 0.075" size="0.025"
            rgba="0.75 0.15 0.12 1" contype="0" conaffinity="0"/>
      <geom name="eye_marker_right" type="sphere" pos="0.14 -0.055 0.075" size="0.025"
            rgba="0.75 0.15 0.12 1" contype="0" conaffinity="0"/>
      <body name="left_eye_mount" pos="0.14 0.055 0.075" euler="0 0 0">
        <camera name="left_eye" xyaxes="0 -1 0 0 0 1" fovy="70"/>
      </body>
      <body name="right_eye_mount" pos="0.14 -0.055 0.075" euler="0 0 0">
        <camera name="right_eye" xyaxes="0 -1 0 0 0 1" fovy="70"/>
      </body>
      <body name="left_wheel" pos="0 0.14 -0.07">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="left_tire" type="cylinder" size="0.09 0.025" euler="90 0 0"
              mass="0.08" rgba="0.04 0.04 0.04 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.14 -0.07">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="right_tire" type="cylinder" size="0.09 0.025" euler="90 0 0"
              mass="0.08" rgba="0.04 0.04 0.04 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <velocity name="left_drive" joint="left_wheel_joint" kv="1" ctrllimited="true"
              ctrlrange="-15 15" forcelimited="true" forcerange="-1 1"/>
    <velocity name="right_drive" joint="right_wheel_joint" kv="1" ctrllimited="true"
              ctrlrange="-15 15" forcelimited="true" forcerange="-1 1"/>
  </actuator>
</mujoco>
