{
  "schema": 1,
  "name": "male_cns_visual_motor_ppo_cart",
  "paths": {
    "circuit": "../visual_motor_circuit",
    "experiment": "../experiment.json",
    "mujoco_model": "arena.xml",
    "checkpoint_dir": "checkpoints",
    "log_dir": "logs"
  },
  "vision": {
    "eye_width": 96,
    "eye_height": 96,
    "visual_retention": 0.3,
    "display_width": 780,
    "display_height": 390
  },
  "network": {
    "weight_training": "source_gain",
    "preserve_transmitter_sign": true,
    "initial_leak": 0.3,
    "initial_bias": 0.0,
    "readout_hidden": 128,
    "critic_hidden": 128,
    "state_clip": 1.0
  },
  "environment": {
    "physics_steps_per_action": 4,
    "max_wheel_speed_m_s": 0.7,
    "wheel_radius_m": 0.09,
    "max_episode_steps": 600,
    "reach_distance_m": 0.35,
    "arena_half_size_m": 3.8,
    "target_height_m": 0.25,
    "initial_target_distance_m": [1.0, 2.8],
    "initial_target_angle_degrees": [-55.0, 55.0]
  },
  "reward": {
    "progress_scale": 8.0,
    "reach_bonus": 20.0,
    "step_penalty": 0.01,
    "idle_speed_threshold_m_s": 0.01,
    "idle_after_steps": 15,
    "idle_penalty": 0.08,
    "spin_penalty_scale": 0.01,
    "energy_penalty_scale": 0.002,
    "wall_collision_penalty": 1.0,
    "lost_distance_penalty_scale": 0.2
  },
  "curriculum": {
    "promotion_success_rate": 0.8,
    "promotion_window": 100,
    "minimum_episodes_per_stage": 120,
    "previous_stage_replay_probability": 0.2,
    "stage2_target_speed_m_s": [0.08, 0.28],
    "stage3_target_speed_m_s": [0.08, 0.35]
  },
  "ppo": {
    "device": "cuda",
    "seed": 7,
    "total_environment_steps": 2000000,
    "rollout_steps": 256,
    "sequence_length": 8,
    "update_epochs": 2,
    "learning_rate": 0.0001,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_ratio": 0.2,
    "value_loss_coefficient": 0.5,
    "entropy_coefficient": 0.002,
    "max_gradient_norm": 0.5,
    "checkpoint_every_steps": 10000,
    "evaluation_every_steps": 5000
  }
}
