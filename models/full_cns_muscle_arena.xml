<mujoco model="TASS muscle diagnostic rig">
  <compiler angle="degree"/>
  <!-- Fixed body and zero gravity isolate driven joint response from falling. -->
  <option timestep="0.005" gravity="0 0 0"/>
  <visual><global offwidth="320" offheight="240"/><headlight ambient="0.3 0.3 0.3" diffuse="0.4 0.4 0.4"/></visual>
  <asset>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.6 0.6 0.6" rgb2="0.85 0.85 0.85" width="256" height="256"/>
    <material name="floor" texture="checker" texrepeat="8 8"/>
  </asset>
  <default>
    <joint type="hinge" limited="true" range="-20 100" damping="0.025" stiffness="0.06" springref="0" armature="0.002"/>
    <geom type="capsule" size="0.018" mass="0.02" contype="0" conaffinity="0"/>
    <motor ctrllimited="true" ctrlrange="-2 2"/>
  </default>
  <worldbody>
    <light name="stimulus_light" pos="0 0 4" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="floor"/>
    <geom name="wall_n" type="box" pos="0 3 0.6" size="3.1 0.1 0.6" rgba="0.75 0.75 0.75 1"/>
    <geom name="wall_s" type="box" pos="0 -3 0.6" size="3.1 0.1 0.6" rgba="0.75 0.75 0.75 1"/>
    <geom name="wall_e" type="box" pos="3 0 0.6" size="0.1 3 0.6" rgba="0.75 0.75 0.75 1"/>
    <geom name="wall_w" type="box" pos="-3 0 0.6" size="0.1 3 0.6" rgba="0.75 0.75 0.75 1"/>
    <body name="target" mocap="true" pos="1.6 0 0.55">
      <geom name="moving_object" type="box" size="0.15 0.2 0.55" rgba="0.7 0.1 0.08 1"/>
    </body>
    <body name="robot" pos="0 0 0.8">
      <geom name="chassis" type="box" size="0.22 0.1 0.06" mass="0.5" rgba="0.15 0.25 0.4 1"/>
      <camera name="eye" pos="0.23 0 0.04" xyaxes="0 -1 0 0 0 1" fovy="70"/>
      <geom name="stand" fromto="0 0 -0.06 0 0 -0.76" size="0.025" rgba="0.45 0.45 0.45 1"/>
      <body name="L_fl_upper" pos="0.15 0.09 0">
        <geom fromto="0 0 0 0 0.23 -0.17" rgba="0.2 0.6 0.9 1"/>
        <body name="L_fl_tibia" pos="0 0.23 -0.17"><joint name="L_fl_joint" axis="1 0 0"/><geom fromto="0 0 0 0 0.17 -0.27" rgba="0.2 0.6 0.9 1"/></body>
      </body>
      <body name="L_ml_upper" pos="0 0.09 0">
        <geom fromto="0 0 0 0 0.23 -0.17" rgba="0.2 0.6 0.9 1"/>
        <body name="L_ml_tibia" pos="0 0.23 -0.17"><joint name="L_ml_joint" axis="1 0 0"/><geom fromto="0 0 0 0 0.17 -0.27" rgba="0.2 0.6 0.9 1"/></body>
      </body>
      <body name="L_hl_upper" pos="-0.15 0.09 0">
        <geom fromto="0 0 0 0 0.23 -0.17" rgba="0.2 0.6 0.9 1"/>
        <body name="L_hl_tibia" pos="0 0.23 -0.17"><joint name="L_hl_joint" axis="1 0 0"/><geom fromto="0 0 0 0 0.17 -0.27" rgba="0.2 0.6 0.9 1"/></body>
      </body>
      <body name="R_fl_upper" pos="0.15 -0.09 0">
        <geom fromto="0 0 0 0 -0.23 -0.17" rgba="0.9 0.5 0.2 1"/>
        <body name="R_fl_tibia" pos="0 -0.23 -0.17"><joint name="R_fl_joint" axis="-1 0 0"/><geom fromto="0 0 0 0 -0.17 -0.27" rgba="0.9 0.5 0.2 1"/></body>
      </body>
      <body name="R_ml_upper" pos="0 -0.09 0">
        <geom fromto="0 0 0 0 -0.23 -0.17" rgba="0.9 0.5 0.2 1"/>
        <body name="R_ml_tibia" pos="0 -0.23 -0.17"><joint name="R_ml_joint" axis="-1 0 0"/><geom fromto="0 0 0 0 -0.17 -0.27" rgba="0.9 0.5 0.2 1"/></body>
      </body>
      <body name="R_hl_upper" pos="-0.15 -0.09 0">
        <geom fromto="0 0 0 0 -0.23 -0.17" rgba="0.9 0.5 0.2 1"/>
        <body name="R_hl_tibia" pos="0 -0.23 -0.17"><joint name="R_hl_joint" axis="-1 0 0"/><geom fromto="0 0 0 0 -0.17 -0.27" rgba="0.9 0.5 0.2 1"/></body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="L_fl_drive" joint="L_fl_joint"/>
    <motor name="L_ml_drive" joint="L_ml_joint"/>
    <motor name="L_hl_drive" joint="L_hl_joint"/>
    <motor name="R_fl_drive" joint="R_fl_joint"/>
    <motor name="R_ml_drive" joint="R_ml_joint"/>
    <motor name="R_hl_drive" joint="R_hl_joint"/>
  </actuator>
</mujoco>
