<mujoco model="TASS navigation experiment">
  <compiler angle="degree"/>
  <option timestep="0.005" gravity="0 0 -9.81"/>
  <visual><global offwidth="320" offheight="240"/><headlight ambient="0.5 0.5 0.5"/></visual>
  <asset>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.7 0.7 0.7" rgb2="0.9 0.9 0.9" width="256" height="256"/>
    <material name="floor" texture="checker" texrepeat="8 8"/>
  </asset>
  <default><geom friction="1.5 0.01 0.001"/><joint damping="0.05"/></default>
  <worldbody>
    <light pos="0 0 4"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="floor"/>
    <geom name="obstacle_front" type="box" pos="1 0 0.3" size="0.15 0.3 0.3" rgba="0.8 0.08 0.05 1"/>
    <geom name="obstacle_left" type="box" pos="2 0.8 0.3" size="0.2 0.25 0.3" rgba="0.8 0.08 0.05 1"/>
    <geom name="obstacle_right" type="box" pos="2.8 -0.6 0.3" size="0.2 0.25 0.3" rgba="0.8 0.08 0.05 1"/>
    <geom name="wall_n" type="box" pos="0 3 0.35" size="3.1 0.1 0.35" rgba="0.75 0.75 0.75 1"/>
    <geom name="wall_s" type="box" pos="0 -3 0.35" size="3.1 0.1 0.35" rgba="0.75 0.75 0.75 1"/>
    <geom name="wall_e" type="box" pos="3 0 0.35" size="0.1 3 0.35" rgba="0.75 0.75 0.75 1"/>
    <geom name="wall_w" type="box" pos="-3 0 0.35" size="0.1 3 0.35" rgba="0.75 0.75 0.75 1"/>
    <!-- Planar two-wheel proxy: physical wheel traction, no imposed x/y motion.
         This constraint simplifies balance and is not the proposed leg mechanism. -->
    <!-- 5 mm contact preload supplies traction under the planar height constraint. -->
    <body name="robot" pos="0 0 0.155">
      <joint name="x" type="slide" axis="1 0 0" damping="0"/>
      <joint name="y" type="slide" axis="0 1 0" damping="0"/>
      <joint name="heading" type="hinge" axis="0 0 1" damping="0"/>
      <geom name="chassis" type="box" size="0.13 0.1 0.06" mass="0.5" rgba="0.15 0.25 0.4 1"/>
      <camera name="eye" pos="0.14 0 0.09" xyaxes="0 -1 0 0 0 1" fovy="70"/>
      <body name="left_wheel" pos="0 0.13 -0.07">
        <joint name="left_motor" type="hinge" axis="0 1 0"/>
        <geom name="left_tire" type="cylinder" size="0.09 0.025" euler="90 0 0" mass="0.08" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.13 -0.07">
        <joint name="right_motor" type="hinge" axis="0 1 0"/>
        <geom name="right_tire" type="cylinder" size="0.09 0.025" euler="90 0 0" mass="0.08" rgba="0.1 0.1 0.1 1"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <velocity name="left_drive" joint="left_motor" kv="1" ctrllimited="true" ctrlrange="-15 15" forcelimited="true" forcerange="-1 1"/>
    <velocity name="right_drive" joint="right_motor" kv="1" ctrllimited="true" ctrlrange="-15 15" forcelimited="true" forcerange="-1 1"/>
  </actuator>
</mujoco>
